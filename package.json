{
  "name": "opencode-codex-usagex",
  "version": "2.0.0",
  "description": "Codex quota probe and OpenCode toast plugin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeblowma/opencode-codex-usagex"
  },
  "homepage": "https://github.com/joeblowma/opencode-codex-usagex#readme",
  "bugs": {
    "url": "https://github.com/joeblowma/opencode-codex-usagex/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "codex",
    "openai",
    "chatgpt",
    "plugin",
    "quota",
    "usage",
    "rate-limit",
    "tui"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/index.js",
    "./tui": "./dist/tui.js",
    "./opencode2": "./dist/index.js",
    "./opencode2/tui": "./dist/tui.js"
  },
  "imports": {
    "#lib/*": "./dist/lib/*",
    "#root/*": "./dist/*"
  },
  "bin": {
    "opencode-codex-usage": "dist/bin/opencode-codex-usage.js"
  },
  "files": [
    "dist/bin/**/*.js",
    "dist/index.js",
    "dist/tui.js",
    "dist/lib/**/*.js",
    "opencode2-tui-plugin",
    "README.md"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.json && chmod +x dist/bin/opencode-codex-usage.js",
    "test": "npm run clean && tsc -p tests/tsconfig.json && chmod +x dist/bin/opencode-codex-usage.js && node --test \"dist/tests/**/*.test.js\"",
    "lint": "oxlint --type-aware --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run",
    "pack": "npm pack"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.12",
    "@opentui/solid": "^0.6.6",
    "solid-js": "1.9.12",
    "zod": "^4.4.3"
  }
}
