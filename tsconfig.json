{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "#lib/*": ["./lib/*"],
      "#root/*": ["./*"]
    },
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["*.ts", "bin/**/*.ts", "lib/**/*.ts", "lib/**/*.tsx"]
}
